{{--
  Barista's popup window.

  The server renders the shell and seeds the panel's initial state; from there
  every value is a signal, refreshed once a second so the countdown ticks.
--}}

<style>
  /*
    A native macOS panel, so it borrows the system's own language: system font,
    a single neutral surface, one accent, and grouping by hairline rather than by
    card. One radius scale (8px, pill for switches), no gradients, no glows.
  */
  :root {
    /* One palette: warm-neutral stone, so the amber accent sits in the same
       family instead of fighting a blue-grey base. */
    --surface: #17161a;
    --surface-raised: #201e24;
    --hairline: #2e2b33;
    --hairline-lit: #453f4a;
    --text: #f2f0ee;
    --text-dim: #a8a29b;
    --text-faint: #6f6a64;
    --accent: #d9a441;
    --accent-lit: #e5b055;
    --accent-wash: rgba(217, 164, 65, 0.14);
    --positive: #6fbf8b;
    --radius: 8px;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html,
  body {
    height: 100%;
    background: var(--surface);
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif;
    font-size: 13px;
    color: var(--text);
    -webkit-font-smoothing: antialiased;
    user-select: none;
    overflow-x: hidden;
    overflow-y: auto;
  }

  /* The panel scrolls, but a scrollbar track over a translucent window reads as
     a stray grey bar down the edge. Scroll without a visible gutter. */
  body::-webkit-scrollbar {
    width: 0;
    height: 0;
  }

  .app {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: 34px 18px 16px;
  }

  /* Header */

  .header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 16px;
  }

  .header h1 {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .version {
    font-size: 11px;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  /* Status */

  .status {
    padding: 8px 0 20px;
  }

  .status-line {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    color: var(--text-dim);
  }

  .status-line.awake {
    color: var(--positive);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .status-line.awake .status-dot {
    animation: breathe 2.4s ease-in-out infinite;
  }

  @keyframes breathe {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .countdown {
    margin-top: 10px;
    font-size: 40px;
    font-weight: 250;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .countdown.idle {
    font-size: 20px;
    color: var(--text-dim);
  }

  .countdown-note {
    margin-top: 6px;
    font-size: 11px;
    color: var(--text-faint);
  }

  /* Primary action */

  .action {
    width: 100%;
    padding: 11px 14px;
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-family: inherit;
    font-size: 13px;
    font-weight: 550;
    cursor: pointer;
    transition: background 0.12s ease, border-color 0.12s ease, transform 0.06s ease;
    -webkit-app-region: no-drag;
  }

  .action:active {
    transform: scale(0.985);
  }

  .action.start {
    background: var(--accent);
    color: #241b09;
  }

  .action.start:hover {
    background: var(--accent-lit);
  }

  .action.stop {
    background: transparent;
    border-color: var(--hairline);
    color: var(--text);
  }

  .action.stop:hover {
    border-color: var(--hairline-lit);
    background: var(--surface-raised);
  }

  /* Groups, separated by hairline rather than boxed in cards */

  .group {
    margin-top: 22px;
    border-top: 1px solid var(--hairline);
    padding-top: 14px;
  }

  .group-title {
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-faint);
    margin-bottom: 10px;
  }

  /* Durations */

  .durations {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 5px;
  }

  .chip {
    padding: 8px 4px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: transparent;
    color: var(--text-dim);
    font-family: inherit;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    transition: border-color 0.12s ease, color 0.12s ease, background 0.12s ease, transform 0.06s ease;
    -webkit-app-region: no-drag;
  }

  .chip:hover {
    color: var(--text);
    border-color: var(--hairline-lit);
  }

  .chip:active {
    transform: scale(0.97);
  }

  .chip.selected {
    border-color: var(--accent);
    background: var(--accent-wash);
    color: var(--accent);
  }

  /* Rows */

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 0;
  }

  .row + .row {
    border-top: 1px solid var(--hairline);
  }

  .row-label {
    font-size: 13px;
    color: var(--text);
  }

  .row-note {
    font-size: 11px;
    color: var(--text-faint);
    margin-top: 2px;
    line-height: 1.35;
  }

  .row-value {
    font-size: 11px;
    color: var(--text-dim);
    font-variant-numeric: tabular-nums;
    padding: 3px 7px;
    border: 1px solid var(--hairline);
    border-radius: 5px;
    white-space: nowrap;
  }

  .hint {
    display: block;
    margin-top: 8px;
    font-size: 11px;
    color: var(--text-faint);
    line-height: 1.4;
  }

  /* Switch */

  .switch {
    border: 0;
    padding: 0;
    position: relative;
    width: 38px;
    height: 22px;
    flex-shrink: 0;
    border-radius: 999px;
    background: #35313b;
    cursor: pointer;
    transition: background 0.16s ease;
    -webkit-app-region: no-drag;
  }

  .switch.on {
    background: var(--accent);
  }

  .switch::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #fff;
    transition: transform 0.16s ease;
  }

  .switch.on::after {
    transform: translateX(16px);
  }

  /* Small button */

  .mini {
    padding: 5px 10px;
    border: 1px solid var(--hairline);
    border-radius: 6px;
    background: transparent;
    color: var(--text-dim);
    font-family: inherit;
    font-size: 11px;
    cursor: pointer;
    white-space: nowrap;
    transition: border-color 0.12s ease, color 0.12s ease;
    -webkit-app-region: no-drag;
  }

  .mini:hover {
    color: var(--text);
    border-color: var(--hairline-lit);
  }

  .mini.primary {
    border-color: var(--accent);
    background: var(--accent-wash);
    color: var(--accent);
  }

  /* Footer */

  .footer {
    margin-top: auto;
    padding-top: 18px;
    font-size: 11px;
    color: var(--text-faint);
  }

  .footer a {
    color: var(--text-dim);
    text-decoration: none;
  }

  .footer a:hover {
    color: var(--text);
  }
</style>

<div class="app" x-ref="root" data-initial-state="{{ initialState }}">
  <div class="header">
    <h1>Barista</h1>
    <span class="version">{{ version }}</span>
  </div>

  <div class="status">
    @if(caffeinated)
      <div class="status-line awake">
        <span class="status-dot"></span>
        <span>Keeping your Mac awake</span>
      </div>
      <div class="countdown" x-text="remainingTime"></div>
      <div class="countdown-note" x-text="durationLabel"></div>
    @else
      <div class="status-line">
        <span class="status-dot"></span>
        <span>Your Mac can sleep</span>
      </div>
      <div class="countdown idle">Ready to brew</div>
    @endif
  </div>

  <button
    class="action"
    :class="{ stop: caffeinated, start: !caffeinated }"
    x-text="caffeinated ? 'Turn Off' : 'Keep Awake'"
    @click="toggleCaffeinate()"
  ></button>

  <p class="hint" role="alert" x-show="errorMessage" x-text="errorMessage"></p>

  <div class="group">
    <div class="group-title">For how long</div>
    <div class="durations">
      @foreach(durations as duration)
        <button
          class="chip"
          :class="{ selected: durationMinutes === {{ duration.minutes }} }"
          :aria-pressed="durationMinutes === {{ duration.minutes }}"
          @click="setDuration({{ duration.minutes }})"
        >{{ duration.short }}</button>
      @endforeach
    </div>
  </div>

  <div class="group">
    <div class="group-title">Menu bar</div>
    <div class="row">
      <div>
        <div class="row-label">Hide a group of menu bar icons</div>
        <div class="row-note">One arrow to hide and reveal your group</div>
      </div>
      <button type="button" class="switch" role="switch" :aria-checked="menuBarGrouping" :class="{ on: menuBarGrouping }" @click="setGrouping()" aria-label="Hide a group of menu bar icons"></button>
    </div>
    <div x-show="menuBarGrouping">
      <p class="hint" x-text="menuBarHint"></p>
      <div class="row">
        <button class="mini" x-show="menuBarNeedsPermission" @click="authorizeMenuBar()">Open System Settings…</button>
        <button class="mini" x-show="menuBarUsable" :aria-busy="menuBarBusy" @click="toggleMenuBar()" x-text="menuBarBusy ? 'Cancel' : menuBarCollapsed ? 'Reveal icons' : 'Hide group'"></button>
        <button class="mini" x-show="menuBarUsable" @click="arrangeMenuBar()">Arrange…</button>
        <span class="row-value">⌘⇧B</span>
      </div>
      <p class="hint">Apps hide together. Wi-Fi and Battery follow the arrow; activity indicators may also hide. Reveal restores them.</p>
    </div>
  </div>

  <div class="group">
    <div class="group-title">Behaviour</div>

    <div class="row">
      <div>
        <div class="row-label">Start awake</div>
        <div class="row-note">Keep the Mac awake as soon as Barista opens</div>
      </div>
      <button type="button" class="switch" role="switch" :aria-checked="caffeinateOnStartup" :class="{ on: caffeinateOnStartup }" @click="savePreference('caffeinateOnStartup', !caffeinateOnStartup)" aria-label="Start awake"></button>
    </div>

    <div class="row">
      <span class="row-label">Open at login</span>
      <button type="button" class="switch" role="switch" :aria-checked="autoLaunch" :class="{ on: autoLaunch }" @click="savePreference('autoLaunch', !autoLaunch)" aria-label="Open at login"></button>
    </div>

    <div class="row">
      <span class="row-label">Keep awake shortcut</span>
      <span class="row-value">Cmd+Shift+C</span>
    </div>
  </div>

  <div class="group">
    <div class="group-title">Updates</div>
    <div class="row">
      <div>
        <div class="row-label">Version {{ version }}</div>
        <div class="row-note" x-text="updateMessage || 'Barista updates itself from GitHub releases'"></div>
      </div>
      <button class="mini" :disabled="updateBusy" @click="checkForUpdates()">Check</button>
    </div>
    <div class="row" :if="updateAvailable">
      <span class="row-label">Ready to install</span>
      <button class="mini primary" :disabled="updateBusy" @click="installUpdate()">Install and restart</button>
    </div>
  </div>

  <div class="footer">
    Built with <a href="https://github.com/stacksjs/stx">stx</a> and <a href="https://github.com/craft-native/craft">Craft</a>
  </div>
</div>
<script client lang="ts">
  import type { BaristaPreferences } from './preferences'
  import type { CaffeinateSnapshot } from './caffeinate'
  import type { MenuBarState } from './menu-bar'
  import { menuBarMessage } from './menu-bar'

  type BaristaState = BaristaPreferences & Omit<CaffeinateSnapshot, 'endsAt'> & {
    endsAt: string | null
    nativeReady: boolean
    menuBarInitialized: boolean
    menuBar: MenuBarState
    shortcutRegistered: boolean
  }
  const bridge = useNativeDesktop()

  const root = useRef<HTMLElement>('root')

  /** Server state, refreshed from /api/status. Seeded so the panel never paints a wrong value. */
  const status = state<Partial<BaristaState>>({})

  const caffeinated = derived(() => status().active === true)
  const remainingTime = derived(() => status().remainingFormatted || '0:00')
  const durationLabel = derived(() => status().durationFormatted || 'Off')
  const durationMinutes = derived(() => status().caffeinateDurationMinutes ?? -1)
  const caffeinateOnStartup = derived(() => status().caffeinateOnStartup === true)
  const autoLaunch = derived(() => status().autoLaunch === true)
  const menuBarGrouping = derived(() => status().menuBarGrouping === true)
  const menuBarCollapsed = derived(() => status().menuBar?.collapsed === true)
  const menuBarBusy = derived(() => status().menuBar?.busy === true)
  const menuBarNeedsPermission = derived(() => status().menuBar?.available === true && status().menuBar?.authorized === false)
  const menuBarUsable = derived(() => status().menuBar?.available === true && status().menuBar?.authorized === true)
  const menuBarHint = derived(() => menuBarMessage(status().menuBar || { initialized: false, collapsed: false }))

  const errorMessage = state('')

  async function refresh() {
    status.set(await fetch('/api/status').then(response => response.json()))
  }

  async function post(path: string, body?: unknown) {
    const response = await fetch(path, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: body === undefined ? undefined : JSON.stringify(body),
    })
    const result = await response.json()
    if (!response.ok) {
      errorMessage.set(result.error || 'Could not apply this change')
      throw new Error(result.error || 'Request failed')
    }
    errorMessage.set('')
    status.set({ ...status(), ...result })
    await syncTray()
  }

  // ===== Caffeinate =====

  async function toggleCaffeinate() {
    await post('/api/caffeinate/toggle')
  }

  async function setDuration(minutes: number) {
    await post('/api/caffeinate/duration', { minutes })
  }

  // ===== Menu bar =====

  let appliedGrouping: boolean | undefined

  async function syncMenuBar() {
    const menubar = bridge()?.menubar
    if (!menubar) return
    const enabled = menuBarGrouping()
    if (appliedGrouping !== enabled) {
      appliedGrouping = enabled
      if (enabled) await menubar.init({ backend: 'nativeVisibility', preserveSystemItems: false })
      else await menubar.destroy()
    }
    const menuBar = await menubar.getState()
    await post('/api/native/state', { menuBar, shortcutRegistered: status().shortcutRegistered === true })
  }

  async function setGrouping() {
    const menubar = bridge()?.menubar
    if (!menubar) return
    const enabled = !menuBarGrouping()
    await savePreference('menuBarGrouping', enabled)
    await syncMenuBar()
  }

  async function authorizeMenuBar() {
    await bridge()?.menubar?.requestPermission()
    await syncMenuBar()
  }

  async function toggleMenuBar() {
    if (menuBarNeedsPermission()) return authorizeMenuBar()
    await bridge()?.menubar?.toggle()
    await syncMenuBar()
  }

  async function arrangeMenuBar() {
    await bridge()?.menubar?.expand()
    await bridge()?.window?.show()
    await syncMenuBar()
  }

  // ===== Preferences =====

  async function savePreference<K extends keyof BaristaPreferences>(key: K, value: BaristaPreferences[K]) {
    await post('/api/preferences', { [key]: value })
  }

  // Seed the panel before the native bridge arrives or the first refresh.
  function loadInitialState() {
    if (Object.keys(status()).length) return
    const initial = root()?.dataset.initialState
    if (!initial) throw new Error('Missing initial Barista state')
    status.set(JSON.parse(initial))
  }

  // ===== Tray =====

  /**
   * Push the icon, tooltip and menu the server describes.
   *
   * Barista shows a cup and no label, like the other caffeinate apps, so the
   * title is cleared once and the icon carries the state. Only changes are sent —
   * this runs every second and macOS need not redraw an identical menu bar.
   */
  let lastTray = ''

  async function syncTray() {
    const tray = bridge()?.tray
    if (!tray) return

    const next = await fetch('/api/tray').then(response => response.json())
    const fingerprint = JSON.stringify(next)
    if (fingerprint === lastTray) return

    // The native template image is the whole item; macOS supplies its tint.
    await tray.setIcon(next.icon)
    await tray.setTitle('')
    await tray.setTooltip(next.tooltip)
    await tray.setMenu(next.menu)
    lastTray = fingerprint
  }

  const TRAY_ACTIONS: Record<string, () => unknown | Promise<unknown>> = {
    toggleCaffeinate,
    toggleMenuBar,
    arrangeMenuBar,
    disableCaffeinate: () => post('/api/caffeinate/disable'),
    preferences: () => bridge()?.window?.show(),
    about: () => bridge()?.window?.show(),
    checkForUpdates: checkForUpdates,
    quit: () => bridge()?.app?.quit(),
  }

  async function runTrayAction(action: string) {
    if (action.startsWith('duration:')) {
      await setDuration(Number.parseInt(action.slice('duration:'.length), 10))
      return
    }

    await TRAY_ACTIONS[action]?.()
    // The menu's labels and checkmarks describe state the action just changed.
    await syncTray()
  }

  // ===== Updates =====

  const updateMessage = state('')
  const updateAvailable = state(false)
  const updateBusy = state(false)

  async function syncUpdates() {
    const result = await fetch('/api/updates').then(r => r.json())
    updateAvailable.set(result.ready)
    updateBusy.set(result.checking || result.installing)
    if (!result.supported) updateMessage.set('Updates apply to the installed app only')
    else if (result.error) updateMessage.set('Update failed: ' + result.error)
    else if (result.installing) updateMessage.set('Installing and restarting…')
    else if (result.checking) updateMessage.set(result.available ? 'Downloading version ' + result.available + '…' : 'Checking for updates…')
    else if (result.ready) updateMessage.set('Version ' + result.available + ' is ready to install')
  }

  async function checkForUpdates() {
    updateBusy.set(true)
    updateMessage.set('Checking for updates…')
    try {
      const result = await fetch('/api/updates/check', { method: 'POST' }).then(r => r.json())
      await syncUpdates()
      if (result.supported && !result.error && !result.available) updateMessage.set('Barista is up to date')
    }
    catch (error) {
      updateMessage.set('Could not check: ' + (error as Error).message)
    }
    finally {
      updateBusy.set(false)
    }
  }

  async function installUpdate() {
    updateBusy.set(true)
    updateMessage.set('Installing and restarting…')
    try {
      const response = await fetch('/api/updates/install', { method: 'POST' })
      if (!response.ok) throw new Error((await response.json()).error || 'Installation failed')
    }
    catch (error) {
      updateBusy.set(false)
      updateMessage.set('Could not install: ' + (error as Error).message)
    }
  }

  useInterval(() => syncUpdates(), 5000)

  // ===== Wiring =====

  useEventListener('craft:tray:menuAction', event => runTrayAction((event as CustomEvent<{ action: string }>).detail.action))
  useEventListener('craft:shortcut', event => {
    const { id } = (event as CustomEvent<{ id: string }>).detail
    if (id === 'barista.caffeinate') toggleCaffeinate()
    if (id === 'barista.menubar' && menuBarGrouping()) toggleMenuBar()
  })
  useEventListener('craft:shortcut:error', () => errorMessage.set('Could not reserve a global shortcut'))

  useEventListener('craft:menubar:stateChange', async event => {
    await syncMenuBar()
    const error = (event as CustomEvent<MenuBarState>).detail.error
    if (error === 'permissionRequired' || error === 'visibilityMismatch')
      await bridge()?.window?.show()
  })

  // The cup toggles awake; the native arrow toggles only the chosen group.
  useEventListener('craft:tray:click', async () => {
    await toggleCaffeinate()
  })

  // Craft owns native grouping, permission checks, click handling and cleanup.
  bridge.onReady(async native => {
    loadInitialState()
    await syncTray()
    const shortcuts = native.shortcuts
    if (!shortcuts) throw new Error('Native shortcuts are unavailable')
    await shortcuts.register('barista.caffeinate', 'Cmd+Shift+C')
    await shortcuts.register('barista.menubar', 'Cmd+Shift+B')
    const registered = await shortcuts.isRegistered('barista.caffeinate')
      && await shortcuts.isRegistered('barista.menubar')
    const menubar = native.menubar
    if (!menubar) throw new Error('Native menu bar state is unavailable')
    status.set({ ...status(), shortcutRegistered: registered })
    await syncMenuBar()
    if (!registered) errorMessage.set('A shortcut is already in use by another app')
  })

  // The countdown ticks in the tray as well as the popup, and the menu's labels
  // follow whatever the state became.
  useInterval(async () => {
    await refresh()
    await syncMenuBar()
    await syncTray()
  }, 1000)
</script>
