{{--
  Barista's popup window.

  The server renders the shell and seeds the panel's initial state; from there
  every value is a signal, refreshed once a second so the countdown ticks.
--}}

<style>
  /*
    A native macOS panel, so it borrows the system's own language: system font,
    a single neutral surface, one accent, and grouping by hairline rather than by
    card. One radius scale (8px, pill for switches), no gradients, no glows.
  */
  :root {
    /* One palette: warm-neutral stone, so the amber accent sits in the same
       family instead of fighting a blue-grey base. */
    --surface: #17161a;
    --surface-raised: #201e24;
    --hairline: #2e2b33;
    --hairline-lit: #453f4a;
    --text: #f2f0ee;
    --text-dim: #a8a29b;
    --text-faint: #6f6a64;
    --accent: #d9a441;
    --accent-lit: #e5b055;
    --accent-wash: rgba(217, 164, 65, 0.14);
    --positive: #6fbf8b;
    --radius: 8px;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html,
  body {
    height: 100%;
    background: var(--surface);
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif;
    font-size: 13px;
    color: var(--text);
    -webkit-font-smoothing: antialiased;
    user-select: none;
    overflow-x: hidden;
    overflow-y: auto;
  }

  /* The panel scrolls, but a scrollbar track over a translucent window reads as
     a stray grey bar down the edge. Scroll without a visible gutter. */
  body::-webkit-scrollbar {
    width: 0;
    height: 0;
  }

  .app {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: 34px 18px 16px;
  }

  /* Header */

  .header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 16px;
  }

  .header h1 {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .version {
    font-size: 11px;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  /* Status */

  .status {
    padding: 8px 0 20px;
  }

  .status-line {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    color: var(--text-dim);
  }

  .status-line.awake {
    color: var(--positive);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .status-line.awake .status-dot {
    animation: breathe 2.4s ease-in-out infinite;
  }

  @keyframes breathe {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .countdown {
    margin-top: 10px;
    font-size: 40px;
    font-weight: 250;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .countdown.idle {
    font-size: 20px;
    color: var(--text-dim);
  }

  .countdown-note {
    margin-top: 6px;
    font-size: 11px;
    color: var(--text-faint);
  }

  /* Primary action */

  .action {
    width: 100%;
    padding: 11px 14px;
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-family: inherit;
    font-size: 13px;
    font-weight: 550;
    cursor: pointer;
    transition: background 0.12s ease, border-color 0.12s ease, transform 0.06s ease;
    -webkit-app-region: no-drag;
  }

  .action:active {
    transform: scale(0.985);
  }

  .action.start {
    background: var(--accent);
    color: #241b09;
  }

  .action.start:hover {
    background: var(--accent-lit);
  }

  .action.stop {
    background: transparent;
    border-color: var(--hairline);
    color: var(--text);
  }

  .action.stop:hover {
    border-color: var(--hairline-lit);
    background: var(--surface-raised);
  }

  /* Groups, separated by hairline rather than boxed in cards */

  .group {
    margin-top: 22px;
    border-top: 1px solid var(--hairline);
    padding-top: 14px;
  }

  .group-title {
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-faint);
    margin-bottom: 10px;
  }

  /* Durations */

  .durations {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 5px;
  }

  .chip {
    padding: 8px 4px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: transparent;
    color: var(--text-dim);
    font-family: inherit;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    transition: border-color 0.12s ease, color 0.12s ease, background 0.12s ease, transform 0.06s ease;
    -webkit-app-region: no-drag;
  }

  .chip:hover {
    color: var(--text);
    border-color: var(--hairline-lit);
  }

  .chip:active {
    transform: scale(0.97);
  }

  .chip.selected {
    border-color: var(--accent);
    background: var(--accent-wash);
    color: var(--accent);
  }

  /* Rows */

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 0;
  }

  .row + .row {
    border-top: 1px solid var(--hairline);
  }

  .row-label {
    font-size: 13px;
    color: var(--text);
  }

  .row-note {
    font-size: 11px;
    color: var(--text-faint);
    margin-top: 2px;
    line-height: 1.35;
  }

  .row-value {
    font-size: 11px;
    color: var(--text-dim);
    font-variant-numeric: tabular-nums;
    padding: 3px 7px;
    border: 1px solid var(--hairline);
    border-radius: 5px;
    white-space: nowrap;
  }

  /* Menu bar control */

  .menubar-btn {
    display: flex;
    align-items: center;
    gap: 9px;
    width: 100%;
    padding: 9px 12px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: transparent;
    color: var(--text);
    font-family: inherit;
    font-size: 13px;
    cursor: pointer;
    transition: border-color 0.12s ease, background 0.12s ease, transform 0.06s ease;
    -webkit-app-region: no-drag;
  }

  .menubar-btn:hover {
    border-color: var(--hairline-lit);
    background: var(--surface-raised);
  }

  .menubar-btn:active {
    transform: scale(0.99);
  }

  .menubar-btn.collapsed {
    border-color: var(--accent);
    color: var(--accent);
  }

  .caret {
    width: 14px;
    text-align: center;
    font-size: 15px;
    color: var(--text-faint);
  }

  .menubar-btn.collapsed .caret {
    color: var(--accent);
  }

  .hint {
    display: block;
    margin-top: 8px;
    font-size: 11px;
    color: var(--text-faint);
    line-height: 1.4;
  }

  /* Switch */

  .switch {
    position: relative;
    width: 38px;
    height: 22px;
    flex-shrink: 0;
    border-radius: 999px;
    background: #35313b;
    cursor: pointer;
    transition: background 0.16s ease;
    -webkit-app-region: no-drag;
  }

  .switch.on {
    background: var(--accent);
  }

  .switch::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #fff;
    transition: transform 0.16s ease;
  }

  .switch.on::after {
    transform: translateX(16px);
  }

  /* Small button */

  .mini {
    padding: 5px 10px;
    border: 1px solid var(--hairline);
    border-radius: 6px;
    background: transparent;
    color: var(--text-dim);
    font-family: inherit;
    font-size: 11px;
    cursor: pointer;
    white-space: nowrap;
    transition: border-color 0.12s ease, color 0.12s ease;
    -webkit-app-region: no-drag;
  }

  .mini:hover {
    color: var(--text);
    border-color: var(--hairline-lit);
  }

  .mini.primary {
    border-color: var(--accent);
    background: var(--accent-wash);
    color: var(--accent);
  }

  /* Footer */

  .footer {
    margin-top: auto;
    padding-top: 18px;
    font-size: 11px;
    color: var(--text-faint);
  }

  .footer a {
    color: var(--text-dim);
    text-decoration: none;
  }

  .footer a:hover {
    color: var(--text);
  }
</style>

<div class="app" x-ref="root" data-initial-state="{{ initialState }}">
  <div class="header">
    <h1>Barista</h1>
    <span class="version">{{ version }}</span>
  </div>

  <div class="status">
    @if(caffeinated)
      <div class="status-line awake">
        <span class="status-dot"></span>
        <span>Keeping your Mac awake</span>
      </div>
      <div class="countdown" x-text="remainingTime"></div>
      <div class="countdown-note" x-text="durationLabel"></div>
    @else
      <div class="status-line">
        <span class="status-dot"></span>
        <span>Your Mac can sleep</span>
      </div>
      <div class="countdown idle">Ready to brew</div>
    @endif
  </div>

  <button
    class="action"
    :class="{ stop: caffeinated, start: !caffeinated }"
    x-text="caffeinated ? 'Turn Off' : 'Keep Awake'"
    @click="toggleCaffeinate()"
  ></button>

  <div class="group">
    <div class="group-title">For how long</div>
    <div class="durations">
      @foreach(durations as duration)
        <button
          class="chip"
          :class="{ selected: durationMinutes === {{ duration.minutes }} }"
          @click="setDuration({{ duration.minutes }})"
        >{{ duration.short }}</button>
      @endforeach
    </div>
  </div>

  <div class="group">
    <div class="group-title">Menu bar</div>
    <button class="menubar-btn" :class="{ collapsed: menuBarCollapsed }" @click="toggleMenuBar()">
      <span class="caret" x-text="menuBarCollapsed ? '&#8250;' : '&#8249;'"></span>
      <span x-text="menuBarCollapsed ? 'Show hidden items' : 'Hide items'"></span>
    </button>
    <span class="hint">Cmd-drag icons to the left of the | divider to tuck them away.</span>

    <div class="row">
      <div>
        <div class="row-label">Auto collapse</div>
        <div class="row-note">Tidy up again after a pause</div>
      </div>
      <div class="switch" :class="{ on: isAutoCollapse }" @click="setAutoCollapse(!isAutoCollapse)"></div>
    </div>

    @if(isAutoCollapse)
      <div class="row">
        <span class="row-label">After</span>
        <div class="durations" style="grid-template-columns: repeat(5, 1fr); flex: 1;">
          @foreach(collapseDelays as seconds)
            <button
              class="chip"
              :class="{ selected: autoCollapseDelay === {{ seconds }} }"
              @click="setCollapseDelay({{ seconds }})"
            >{{ seconds }}s</button>
          @endforeach
        </div>
      </div>
    @endif

    <div class="row">
      <div>
        <div class="row-label">Always-hidden section</div>
        <div class="row-note">A second group that stays tucked away</div>
      </div>
      <div class="switch" :class="{ on: alwaysHiddenEnabled }" @click="setAlwaysHidden(!alwaysHiddenEnabled)"></div>
    </div>

    <div class="row">
      <div>
        <div class="row-label">Hide the divider</div>
        <div class="row-note">Make the | divider invisible</div>
      </div>
      <div class="switch" :class="{ on: separatorHidden }" @click="setSeparatorHidden(!separatorHidden)"></div>
    </div>
  </div>

  <div class="group">
    <div class="group-title">Behaviour</div>

    <div class="row">
      <div>
        <div class="row-label">Start awake</div>
        <div class="row-note">Keep the Mac awake as soon as Barista opens</div>
      </div>
      <div class="switch" :class="{ on: caffeinateOnStartup }" @click="savePreference('caffeinateOnStartup', !caffeinateOnStartup)"></div>
    </div>

    <div class="row">
      <span class="row-label">Open at login</span>
      <div class="switch" :class="{ on: autoLaunch }" @click="savePreference('autoLaunch', !autoLaunch)"></div>
    </div>

    <div class="row">
      <span class="row-label">Shortcut</span>
      <span class="row-value" x-text="globalHotkey"></span>
    </div>
  </div>

  <div class="group">
    <div class="group-title">Updates</div>
    <div class="row">
      <div>
        <div class="row-label">Version {{ version }}</div>
        <div class="row-note" x-text="updateMessage || 'Barista updates itself from GitHub releases'"></div>
      </div>
      <button class="mini" @click="checkForUpdates()">Check</button>
    </div>
    <div class="row" :if="updateAvailable">
      <span class="row-label">Ready to install</span>
      <button class="mini primary" @click="installUpdate()">Install and restart</button>
    </div>
  </div>

  <div class="footer">
    Built with <a href="https://github.com/stacksjs/stx">stx</a> and <a href="https://github.com/stacksjs/craft">Craft</a>
  </div>
</div>
<script client>
  // Craft's native bridge owns the tray and the menu bar, and there is no stx
  // primitive for it — this is the one place the popup reaches for a browser
  // global. Everything else below is signals.
  const bridge = () => window.craft

  const root = ref()

  /** Server state, refreshed from /api/status. Seeded so the panel never paints a wrong value. */
  const status = state({})

  const caffeinated = derived(() => status().active === true)
  const remainingTime = derived(() => status().remainingFormatted || '0:00')
  const durationLabel = derived(() => status().durationFormatted || 'Off')
  const durationMinutes = derived(() => status().caffeinateDurationMinutes ?? -1)
  const isAutoCollapse = derived(() => status().isAutoCollapse === true)
  const autoCollapseDelay = derived(() => status().autoCollapseDelay ?? 10)
  const alwaysHiddenEnabled = derived(() => status().alwaysHiddenEnabled === true)
  const separatorHidden = derived(() => status().separatorHidden === true)
  const caffeinateOnStartup = derived(() => status().caffeinateOnStartup === true)
  const autoLaunch = derived(() => status().autoLaunch === true)
  const globalHotkey = derived(() => status().globalHotkey || 'Cmd+Shift+B')

  const menuBarCollapsed = state(false)

  async function refresh() {
    status.set(await fetch('/api/status').then(response => response.json()))
  }

  async function post(path, body) {
    const response = await fetch(path, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: body === undefined ? undefined : JSON.stringify(body),
    })
    status.set({ ...status(), ...await response.json() })
  }

  // ===== Caffeinate =====

  async function toggleCaffeinate() {
    await post('/api/caffeinate/toggle')
  }

  async function setDuration(minutes) {
    await post('/api/caffeinate/duration', { minutes })
  }

  // ===== Preferences =====

  async function savePreference(key, value) {
    await post('/api/preferences', { [key]: value })
  }

  async function setAutoCollapse(enabled) {
    await savePreference('isAutoCollapse', enabled)
    await bridge()?.menubar?.setAutoCollapse(enabled ? autoCollapseDelay() : 0)
  }

  async function setCollapseDelay(seconds) {
    await savePreference('autoCollapseDelay', seconds)
    await bridge()?.menubar?.setAutoCollapse(seconds)
  }

  async function setAlwaysHidden(enabled) {
    await savePreference('alwaysHiddenEnabled', enabled)
    const menubar = bridge()?.menubar
    await (enabled ? menubar?.enableAlwaysHidden() : menubar?.disableAlwaysHidden())
  }

  async function setSeparatorHidden(hidden) {
    await savePreference('separatorHidden', hidden)
    await bridge()?.menubar?.setSeparatorHidden(hidden)
  }

  // ===== Menu bar =====

  async function toggleMenuBar() {
    await bridge()?.menubar?.toggle()
  }

  /** The tray menu labels the collapse state, so tell the server when it flips. */
  async function reportMenuBarState(collapsed) {
    menuBarCollapsed.set(collapsed)
    await fetch('/api/menu-bar/state', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ collapsed }),
    })
  }

  // The server rendered this panel's starting state into the markup. Read it
  // straight out rather than waiting a round trip and painting a stale panel —
  // and read it here rather than only on mount, because `initMenuBar` runs
  // whenever the bridge comes up, which may be first. It once did, and read an
  // empty state: auto collapse was silently off on every launch.
  function loadInitialState() {
    if (Object.keys(status()).length) return
    status.set(JSON.parse(root().dataset.initialState))
  }

  async function initMenuBar() {
    const menubar = bridge()?.menubar
    if (!menubar) return

    loadInitialState()

    await menubar.init()
    if (alwaysHiddenEnabled()) await menubar.enableAlwaysHidden()
    if (separatorHidden()) await menubar.setSeparatorHidden(true)

    // Only tidy the menu bar if that was asked for. Collapsing unconditionally
    // hid Barista's own icon on every launch.
    if (isAutoCollapse()) {
      await menubar.setAutoCollapse(autoCollapseDelay())
      await menubar.collapse()
    }

    await reportMenuBarState(isAutoCollapse())
  }

  // ===== Tray =====

  /**
   * Push the icon, tooltip and menu the server describes.
   *
   * Barista shows a cup and no label, like the other caffeinate apps, so the
   * title is cleared once and the icon carries the state. Only changes are sent —
   * this runs every second and macOS need not redraw an identical menu bar.
   */
  let lastTray = ''

  async function syncTray() {
    const tray = bridge()?.tray
    if (!tray) return

    const next = await fetch('/api/tray').then(response => response.json())
    const fingerprint = JSON.stringify(next)
    if (fingerprint === lastTray) return
    lastTray = fingerprint

    // A template image when this Craft binary can draw one — the title stays
    // empty so the cup is the whole item — and a text cup when it cannot.
    if (next.useIcon) await tray.setIcon(next.icon)
    await tray.setTitle(next.useIcon ? '' : next.glyph)
    await tray.setTooltip(next.tooltip)
    await tray.setMenu(next.menu)
  }

  const TRAY_ACTIONS = {
    toggleCaffeinate,
    disableCaffeinate: () => post('/api/caffeinate/disable'),
    toggleMenuBar,
    toggleAutoCollapse: () => setAutoCollapse(!isAutoCollapse()),
    toggleAlwaysHidden: () => setAlwaysHidden(!alwaysHiddenEnabled()),
    preferences: () => bridge()?.window?.show(),
    about: () => bridge()?.window?.show(),
    checkForUpdates: checkForUpdates,
    quit: () => bridge()?.app?.quit(),
  }

  async function runTrayAction(action) {
    if (action.startsWith('duration:')) {
      await setDuration(Number.parseInt(action.slice('duration:'.length), 10))
      return
    }

    await TRAY_ACTIONS[action]?.()
    // The menu's labels and checkmarks describe state the action just changed.
    await syncTray()
  }

  // ===== Updates =====

  const updateMessage = state('')
  const updateAvailable = state(false)

  async function checkForUpdates() {
    updateMessage.set('Checking for updates…')
    const result = await fetch('/api/updates/check', { method: 'POST' }).then(r => r.json())
    updateAvailable.set(Boolean(result.available))

    if (!result.supported) updateMessage.set('Updates apply to the installed app only')
    else if (result.error) updateMessage.set('Could not check: ' + result.error)
    else if (result.available) updateMessage.set('Version ' + result.available + ' is ready to install')
    else updateMessage.set('Barista is up to date')
  }

  async function installUpdate() {
    updateMessage.set('Installing…')
    await fetch('/api/updates/install', { method: 'POST' })
  }

  // ===== Wiring =====

  useEventListener('craft:menubar:stateChange', event => reportMenuBarState(event.detail.collapsed))
  useEventListener('craft:tray:menuAction', event => runTrayAction(event.detail.action))

  // Left click brews or stops the coffee, the way the other caffeinate apps
  // behave; right click opens the menu natively and never reaches here.
  //
  // While the bar is tucked away, though, this icon is the way back. A widened
  // marker draws nothing and so cannot be aimed at, and a separate always-there
  // toggle would be a third icon in a bar Barista exists to empty — so the one
  // icon that is guaranteed to survive a collapse takes the job.
  useEventListener('craft:tray:click', async () => {
    if (menuBarCollapsed()) {
      await toggleMenuBar()
      return
    }

    await toggleCaffeinate()
    await syncTray()
  })

  // The bridge may already be up by the time this script runs, so set the tray
  // up now *and* on craft:ready — whichever comes first wins, and syncTray
  // no-ops when nothing changed.
  useEventListener('craft:ready', () => { initMenuBar(); syncTray() })

  onMount(async () => {
    loadInitialState()

    await initMenuBar()
    await syncTray()
    await bridge()?.app?.registerShortcut(globalHotkey(), toggleMenuBar)
  })

  // The countdown ticks in the tray as well as the popup, and the menu's labels
  // follow whatever the state became.
  useInterval(async () => {
    await refresh()
    await syncTray()
  }, 1000)
</script>
