<script server>
export const source = $props.source
export const description = $props.description
export const loading = $props.eager === 'true' ? 'eager' : 'lazy'
export const priority = $props.eager === 'true' ? 'high' : 'auto'
</script>

<!-- Actual packaged stx content, captured at the native panel viewport. -->
<div class="native-frame">
  <img class="native-shot" src="{{ source }}" width="320" height="740" alt="{{ description }}" loading="{{ loading }}" fetchpriority="{{ priority }}">
</div>
