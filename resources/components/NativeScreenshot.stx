<script server>
export const source = $props.source
export const description = $props.description
export const loading = $props.eager === 'true' ? 'eager' : 'lazy'
export const priority = $props.eager === 'true' ? 'high' : 'auto'
</script>

<!-- Focus the capture on app content, omitting the screen-share window badge. -->
<div class="native-frame">
  <img class="native-shot" src="{{ source }}" width="640" height="1480" alt="{{ description }}" loading="{{ loading }}" fetchpriority="{{ priority }}">
</div>
