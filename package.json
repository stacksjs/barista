{
  "name": "barista",
  "private": true,
  "type": "module",
  "version": "0.0.13",
  "description": "A tiny, native macOS menu bar app that keeps your Mac awake — a free replacement for Caffeine, Amphetamine and KeepingYouAwake.",
  "author": "Chris Breuer <chris@stacksjs.com>",
  "license": "MIT",
  "homepage": "https://github.com/stacksjs/barista#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/barista.git"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/barista/issues"
  },
  "keywords": [
    "barista",
    "caffeinate",
    "caffeine",
    "amphetamine",
    "keep-awake",
    "prevent-sleep",
    "menubar",
    "menu-bar",
    "management",
    "app",
    "macos",
    "mac"
  ],
  "scripts": {
    "dev": "bun --bun run app.ts",
    "build": "bun --bun run build.ts",
    "lint": "bunx --bun pickier .",
    "lint:fix": "bunx --bun pickier . --fix",
    "format": "bunx --bun pickier . --format",
    "format:fix": "bunx --bun pickier . --format --write",
    "fresh": "bunx rimraf node_modules/ bun.lock && bun i",
    "changelog": "bunx --bun @stacksjs/logsmith --output CHANGELOG.md",
    "release": "bunx --bun @stacksjs/bumpx prompt --recursive",
    "release:patch": "bunx --bun @stacksjs/bumpx patch --recursive --commit --tag --push --yes",
    "release:minor": "bunx --bun @stacksjs/bumpx minor --recursive --commit --tag --push --yes",
    "release:major": "bunx --bun @stacksjs/bumpx major --recursive --commit --tag --push --yes",
    "test": "bun test",
    "dev:docs": "bun --bun bunpress dev",
    "build:docs": "bun --bun bunpress build",
    "preview:docs": "bun --bun bunpress preview --outdir storage/framework/docs",
    "typecheck": "bunx --bun tsc --noEmit && bun run typecheck:views",
    "test:native": "bun scripts/native-e2e.ts",
    "check": "bun run lint && bun run typecheck && bun test",
    "typecheck:views": "bunx --bun stx typecheck 'src/**/*.stx' 'resources/**/*.stx' --lib src/template-context.d.ts",
    "build:site": "bun scripts/build-site.ts && bun scripts/check-site.ts",
    "preview:site": "bun scripts/preview-site.ts",
    "deploy:site": "cloud deploy --env production --site marketing --yes",
    "deploy:site:plan": "cloud deploy --env production --site marketing --dry-run",
    "verify:site": "bun scripts/verify-site.ts",
    "build:app-store": "bun --bun run build.ts --app-store",
    "test:native:store": "bun scripts/native-store-e2e.ts"
  },
  "dependencies": {
    "@stacksjs/stx": "^0.2.696"
  },
  "devDependencies": {
    "@stacksjs/bumpx": "^0.2.28",
    "@stacksjs/bunpress": "^0.2.25",
    "@stacksjs/ts-cloud": "^0.16.69",
    "@stacksjs/ts-css": "^0.3.19",
    "better-dx": "^0.2.38",
    "ts-pantry": "0.11.128"
  },
  "git-hooks": {
    "pre-commit": {
      "staged-lint": {
        "*.{js,ts,json,yaml,yml,md}": "bunx --bun pickier lint --fix"
      }
    },
    "commit-msg": "bunx gitlint --edit .git/COMMIT_EDITMSG"
  }
}
